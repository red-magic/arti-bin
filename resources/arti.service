[Unit]
Description=Arti Tor Service
After=network.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=exec
User=arti
Group=arti
ExecStart=/usr/bin/arti proxy -c /etc/arti/arti.toml
ExecReload=/bin/kill -HUP ${MAINPID}
KillSignal=SIGINT
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
ReadWritePaths=/var/lib/arti

# Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=all

# Network
RestrictAddressFamilies=AF_INET AF_INET6

# Kernel/Process
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private

# Misc
UMask=0077
LimitCORE=0
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
