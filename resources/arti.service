[Unit]
Description=Arti Tor Service
After=network.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=exec
User=arti
ExecStart=/usr/bin/arti proxy -c /etc/arti/arti.toml
ExecReload=/bin/kill -HUP ${MAINPID}
KillSignal=SIGINT
Restart=on-failure

[Install]
WantedBy=multi-user.target
