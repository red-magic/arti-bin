#!/bin/bash

set -euo pipefail

container_arti="rust:slim-trixie"
container_lyrebird="golang:trixie"
container_arc="debian:trixie-slim"

arti_ver="1.7.0"
lyrebird_ver="0.6.2"

arti_url="https://gitlab.torproject.org/tpo/core/arti/-/archive/arti-v${arti_ver}/arti-arti-v${arti_ver}.tar.gz"
lyrebird_url="https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/lyrebird/-/archive/lyrebird-${lyrebird_ver}/lyrebird-lyrebird-${lyrebird_ver}.tar.gz"

build_arti_linux() {
    set -euo pipefail

    apt-get update -y
    apt-get install -y pkg-config libssl-dev libsqlite3-dev curl

    if ! curl --connect-timeout 5 -LO "${arti_url}"; then
        curl --connect-timeout 10 --socks5 127.0.0.1:9150 -LO "${arti_url}"
    fi

    tar xvf arti-arti-v${arti_ver}.tar.gz
    cd arti-arti-v${arti_ver}

    cargo build -p arti --locked --release
    strip -sv target/release/arti

    cp -v target/release/arti /out/release/linux
    cp -v crates/arti/src/arti-example-config.toml /out/release/linux/arti-example.toml
}

build_lyrebird_linux() {
    set -euo pipefail

    if ! curl --connect-timeout 5 -LO "${lyrebird_url}"; then
        curl --connect-timeout 10 --socks5 127.0.0.1:9150 -LO "${lyrebird_url}"
    fi

    tar xvf lyrebird-lyrebird-${lyrebird_ver}.tar.gz
    cd lyrebird-lyrebird-${lyrebird_ver}

    CGO_ENABLED=1 go build -ldflags="-X main.lyrebirdVersion=${lyrebird_ver} -w -s" -v -o lyrebird ./cmd/lyrebird

    cp -v lyrebird /out/release/linux
}

build_arti_windows() {
    set -euo pipefail

    apt-get update -y
    apt-get install -y mingw-w64 pkg-config libssl-dev libsqlite3-dev curl
    rustup target add x86_64-pc-windows-gnu

    if ! curl --connect-timeout 5 -LO "${arti_url}"; then
        curl --connect-timeout 10 --socks5 127.0.0.1:9150 -LO "${arti_url}"
    fi

    tar xvf arti-arti-v${arti_ver}.tar.gz
    cd arti-arti-v${arti_ver}

    cargo build -p arti --locked --release --target x86_64-pc-windows-gnu --features static
    strip -sv target/x86_64-pc-windows-gnu/release/arti.exe

    cp -v target/x86_64-pc-windows-gnu/release/arti.exe /out/release/windows
    cp -v crates/arti/src/arti-example-config.toml /out/release/windows/arti-example.toml
}

build_lyrebird_windows() {
    set -euo pipefail

    if ! curl --connect-timeout 5 -LO "${lyrebird_url}"; then
        curl --connect-timeout 10 --socks5 127.0.0.1:9150 -LO "${lyrebird_url}"
    fi

    tar xvf lyrebird-lyrebird-${lyrebird_ver}.tar.gz
    cd lyrebird-lyrebird-${lyrebird_ver}

    GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -ldflags="-X main.lyrebirdVersion=${lyrebird_ver} -w -s" -v -o lyrebird.exe ./cmd/lyrebird

    cp -v lyrebird.exe /out/release/windows
}

build_arc_linux() {
    set -euo pipefail

    mkdir -vp linux/arti

    cp -vf /out/release/linux/arti linux/arti
    cp -vf /out/release/linux/lyrebird linux/arti
    cp -vf /out/release/linux/arti-example.toml linux/arti
    cp -vf /out/resources/include/arti-linux.toml linux/arti/arti.toml
    cp -vf /out/resources/include/start-arti linux/arti

    cd linux
    tar czvf arti-linux.tar.gz arti --owner 0 --group 0 --numeric-owner
    cp -vf arti-linux.tar.gz /out/release
}

build_arc_windows() {
    set -euo pipefail

    apt-get update -y
    apt-get install -y zip

    mkdir -vp windows/arti

    cp -vf /out/release/windows/arti.exe windows/arti
    cp -vf /out/release/windows/lyrebird.exe windows/arti
    cp -vf /out/release/windows/arti-example.toml windows/arti
    cp -vf /out/resources/include/arti-windows.toml windows/arti/arti.toml
    cp -vf /out/resources/include/start-arti.bat windows/arti

    cd windows
    zip -Xr arti-windows.zip arti
    cp -vf arti-windows.zip /out/release
}

case "${1:-}" in
    "linux")
        mkdir -vp release/linux

        docker run --rm                     \
               --env arti_ver="${arti_ver}" \
               --env arti_url="${arti_url}" \
               --network=host               \
               -v "$(pwd)":/out             \
               -w /build                    \
               "${container_arti}"          \
               bash -c "$(declare -f build_arti_linux) && build_arti_linux"

        docker run --rm                             \
               --env lyrebird_ver="${lyrebird_ver}" \
               --env lyrebird_url="${lyrebird_url}" \
               --network=host                       \
               -v "$(pwd)":/out                     \
               -w /build                            \
               "${container_lyrebird}"              \
               bash -c "$(declare -f build_lyrebird_linux) && build_lyrebird_linux"

        docker run --rm           \
               -v "$(pwd)":/out   \
               -w /build          \
               "${container_arc}" \
               bash -c "$(declare -f build_arc_linux) && build_arc_linux"
        ;;

    "windows")
        mkdir -vp release/windows

        docker run --rm                     \
               --env arti_ver="${arti_ver}" \
               --env arti_url="${arti_url}" \
               --network=host               \
               -v "$(pwd)":/out             \
               -w /build                    \
               "${container_arti}"          \
               bash -c "$(declare -f build_arti_windows) && build_arti_windows"

        docker run --rm                             \
               --env lyrebird_ver="${lyrebird_ver}" \
               --env lyrebird_url="${lyrebird_url}" \
               --network=host                       \
               -v "$(pwd)":/out                     \
               -w /build                            \
               "${container_lyrebird}"              \
               bash -c "$(declare -f build_lyrebird_windows) && build_lyrebird_windows"

        docker run --rm           \
               -v "$(pwd)":/out   \
               -w /build          \
               "${container_arc}" \
               bash -c "$(declare -f build_arc_windows) && build_arc_windows"
        ;;

    *)
        printf "Usage: %s <linux | windows>\n" "$(basename "${0}")"
        ;;
esac
